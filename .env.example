APP_ENV=development
FLASK_SECRET_KEY=generate-a-unique-secret-before-running
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_local_mysql_username
DB_PASSWORD=your_local_mysql_password
DB_NAME=openshelf_local
# Optional; basic Google Books searches work without a key.
GOOGLE_BOOKS_API_KEY=
# Optional cover/profile upload directory. Relative paths are inside the project.
UPLOAD_FOLDER=uploads
